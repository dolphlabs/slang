
# ---- appended by the website branch (scripts/assemble.sh) ----
# Vite names every built asset by its content hash, so it never changes
# under the same URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  Link: </.well-known/api-catalog>; rel="api-catalog", </api.json>; rel="service-desc"; type="application/json", </llms-small.txt>; rel="service-doc"; type="text/plain", </llms.txt>; rel="describedby"; type="text/plain", </index.md>; rel="alternate"; type="text/markdown"

# RFC 9727: the API catalog, a linkset. The file has no extension, so its
# type is set here; the profile parameter names the RFC it follows.
/.well-known/api-catalog
  Content-Type: application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
