slangc
main
AGENTS.md
main2
.claude/
tools/

# `main`/`main2` above are unanchored on purpose, to catch the
# `slangc --run file.sl` leftover binary (named after its source)
# wherever a test/example directory produces one -- but that also
# swallows this one legitimate `src/main/` Maven source tree, silently
# (bench's Java api implementation shipped without Main.java for
# exactly this reason). Un-ignore it explicitly.
!bench/suite/api/java/src/main/
tests/pkgpin/slang.project
tests/pkgpin/slang.lock
tests/pkgtrans/slang.project
tests/pkgtrans/slang.lock

main.gen.c
slangc-dist
dist/

# `slangc --run file.sl` leaves a binary named after the source next to
# it. demo/samplex/server.sl produced a committed `server` binary once
# already; these are the ones this repo actually builds.
server
arr
cc
hb

# built by `make test` from tests/runtime/test_gc.c; a committed copy is
# a macOS binary that a Linux checkout would try to execute
tests/runtime/test_gc

# bench/suite: build output, generated datasets and language toolchain
# artifacts. bench/results/<run id>/ IS committed (that's the deliverable).
bench/.build/
bench/.data/
bench/suite/**/target/
bench/suite/**/target-*/
bench/suite/**/out/
bench/suite/**/bin/
bench/suite/**/obj/
bench/suite/**/node_modules/
bench/suite/**/venv/
bench/suite/api/java/target/
bench/suite/api/java/dependency-reduced-pom.xml
bench/suite/**/__pycache__/
bench/suite/**/*.pyc

# Python bytecode from tests/*/check.py
__pycache__/
*.pyc
