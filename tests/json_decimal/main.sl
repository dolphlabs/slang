let bad = 0;
let checked = 0;
for s in inputs {
    let want = via_parse(s);
    let as_str = via_json("{\"amount\":\"" + s + "\"}");
    if as_str != want {
        bad += 1;
        println("string " + s + ": json " + as_str + ", parse " + want);
    }
    checked += 1;
    if json_number_ok(s) {
        let as_num = via_json("{\"amount\":" + s + "}");
        if as_num != want {
            bad += 1;
            println("number " + s + ": json " + as_num + ", parse " + want);
        }
        checked += 1;
    }
}
println(bad == 0);
println(checked > 200);

// encoding: exact strings, scale kept, round trip through decode
let p = Price { amount: decimal.parse("-0.050") ?? decimal.zero() };
println(json.encode(p));
let l = Line { sku: "a1", price: decimal.parse("19.90") ?? decimal.zero(),
               discount: none, tiers: [decimal.parse("1") ?? decimal.zero(),
                                       decimal.parse("0.00000000000000000000000000000000000001") ?? decimal.zero(),
                                       decimal.parse("99999999999999999999999999999999999999") ?? decimal.zero()] };
let text = json.encode(l);
println(text);
let back: result[Line, str] = json.decode(text);
guard let l2 = back else let e = err_of(back) { panic(e); }
println(json.encode(l2) == text);
let withd: result[Line, str] = json.decode("{\"sku\":\"b\",\"price\":12.5e-1,\"discount\":\"0.10\",\"tiers\":[]}");
guard let l3 = withd else let e = err_of(withd) { panic(e); }
println(decimal.format(l3.price) + " " + decimal.format(l3.discount ?? decimal.zero()));

// errors name the problem
let e1: result[Price, str] = json.decode("{\"amount\":true}");
println(err_of(e1));
let e2: result[Price, str] = json.decode("{\"amount\":\"12.3.4\"}");
println(err_of(e2));
let e3: result[Price, str] = json.decode("{\"amount\":1e39}");
println(err_of(e3));

// A string with an escape is not read on the fast path; the tree decoder
// takes it, by the same rules.
let esc: result[Price, str] = json.decode("{\"amount\":\"\\u0031.50\"}");
guard let pe = esc else let e = err_of(esc) { panic(e); }
println(decimal.format(pe.amount));
