// decimal.Decimal in JSON: written as an exact string, read from a string
// or a number by decimal.parse's rules, in C (runtime/sl_json.c). Every
// input here goes through json.decode as a string and, where JSON allows
// it, as a number, and must give exactly what decimal.parse gives:
// the same value and scale, or an error in both.

import "decimal";
import "json";

gc struct Price { amount: decimal.Decimal }
gc struct Line { sku: str, price: decimal.Decimal, discount: opt[decimal.Decimal], tiers: [decimal.Decimal] }

fn via_parse(s: str) -> str {
    let r = decimal.parse(s);
    if let v = r {
        return decimal.format(v);
    }
    return "error";
}

fn via_json(text: str) -> str {
    let r: result[Price, str] = json.decode(text);
    if let p = r {
        return decimal.format(p.amount);
    }
    return "error";
}

// JSON numbers have no '+', no leading zeros, a digit on both sides of
// the point: only those inputs are tried as numbers.
fn json_number_ok(s: str) -> bool {
    let b = to_bytes(s);
    if len(b) == 0 { return false; }
    let i = 0;
    if b[0] == 45 { i = 1; }
    if i >= len(b) || b[i] < 48 || b[i] > 57 { return false; }
    if b[i] == 48 && i + 1 < len(b) && b[i + 1] >= 48 && b[i + 1] <= 57 { return false; }
    for k in i..len(b) {
        let c = b[k];
        if !((c >= 48 && c <= 57) || c == 46 || c == 101 || c == 69 || c == 45 || c == 43) {
            return false;
        }
    }
    return true;
}

