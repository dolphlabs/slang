// xml.parse against Python's expat over cases.txt: the same documents
// accepted and refused, and the same tree for each accepted one --
// elements as {namespace}local, attributes sorted, adjacent text joined.
// expected.txt is expat's output (generated by a script outside the
// repository; one case is refused here on purpose and marked so there:
// an ISO-8859-1 declaration, which expat decodes and this does not).
import "fs";
import "sort";
import "strings";
import "xml";

fn slurp(path: str) -> str {
    let or = fs.open(path);
    guard let fd = or else let e = err_of(or) { panic(path + ": " + e); }
    let out: bytes = b"";
    while true {
        let rr = fs.read(fd as int, 65536);
        guard let chunk = rr else let e = err_of(rr) { panic(e); }
        if len(chunk) == 0 {
            break;
        }
        out = out + chunk;
    }
    fs.close(fd as int);
    return to_str(out);
}

fn q(v: str) -> str {
    let s = strings.replace(v, "\\", "\\\\");
    s = strings.replace(s, "\"", "\\\"");
    s = strings.replace(s, "\n", "\\n");
    s = strings.replace(s, "\t", "\\t");
    s = strings.replace(s, "\r", "\\r");
    return "\"" + s + "\"";
}

fn qname(ns: str, local: str) -> str {
    if len(ns) == 0 {
        return local;
    }
    return "{" + ns + "}" + local;
}

fn dump(n: xml.Node, depth: int) {
    let pad = strings.repeat("  ", depth);
    if n.kind == xml.Kind.Text {
        println(pad + "T " + q(n.text));
        return;
    }
    if n.kind != xml.Kind.Element {
        return;
    }
    let attrs: [str] = [];
    for a in n.attrs {
        if a.ns == "http://www.w3.org/2000/xmlns/" {
            continue;
        }
        push(attrs, qname(a.ns, a.local) + "=" + q(a.value));
    }
    let line = pad + "E " + qname(n.ns, n.local);
    if len(attrs) > 0 {
        line = line + " " + strings.join(sort.strings(attrs), " ");
    }
    println(line);
    for c in n.children {
        dump(c, depth + 1);
    }
}

let cases = strings.split(slurp("tests/xml_parity/cases.txt"), "\n----\n");
let i = 0;
for doc in cases {
    i += 1;
    if len(strings.trim(doc)) == 0 {
        continue;
    }
    let r = xml.parse(doc);
    guard let root = r else {
        println("case " + to_str(i) + ": refused");
        continue;
    }
    println("case " + to_str(i) + ": ok");
    dump(root, 0);
}
