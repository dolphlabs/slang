fn round_trip(depth: int, text: str) -> int {
    if depth > 0 {
        return round_trip(depth - 1, text);
    }
    let r: result[Wide, str] = json.decode(text);
    guard let w = r else let e = err_of(r) {
        println("decode: " + e);
        return 0;
    }
    let back = json.encode(w);
    let shown = inspect(w);
    return len(w.a0) + len(w.a199) + len(back) / 1000 + len(shown) / 1000;
}

