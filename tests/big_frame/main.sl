// A function with a great many call sites.
//
// clang gives every call site its own 8-byte spill slot and inlines the callee
// into its caller, so run()'s C frame is about 5.7KB. The task stack starts at
// 8KB and only grows at a safepoint, which runs AFTER the frame is allocated,
// so the frame overflowed into the guard page and the program died with
// SIGBUS before it printed anything. (macOS makes it worse: a frame over 4KB
// is allocated through ___chkstk_darwin, which probes a whole page below it.)
// gcc gave the same C a frame of a few hundred bytes and was never affected.
//
// The fix is an entry guard, chosen from the C compiler's own frame report:
// see sl_rt_stack_reserve and the frame loop in src/main.c. This program has
// to print the same number wherever it is built.
//
// Each call returns 3*i + 2 (see the key in the map), so the sum is
// 3 * N(N+1)/2 + 2N for N = 700.

fn work(xs: [int], m: map[str]int, s: str) -> int {
    let total = 0;
    for x in xs {
        if x % 2 == 0 { total = total + x; } else { total = total - 1; }
    }
    let key = s + "k";
    if has(m, key) { total = total + m[key]; }
    m[key] = total;
    let parts: [str] = [];
    push(parts, key);
    push(parts, to_str(total));
    return total + len(parts);
}

fn run() -> int {
    let xs: [int] = [1, 2, 3, 4, 5];
    let m: map[str]int = {};
    let t = 0;
    t = t + work(xs, m, "k");
    t = t + work(xs, m, "k");
    t = t + work(xs, m, "k");
    t = t + work(xs, m, "k");
    t = t + work(xs, m, "k");
    t = t + work(xs, m, "k");
    t = t + work(xs, m, "k");
    t = t + work(xs, m, "k");
    t = t + work(xs, m, "k");
