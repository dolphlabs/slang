fn dive(n: int, k: str, p: str) -> int {
    if n == 0 {
        let c = crypto.rsa_encrypt_oaep_sha256(p, b"hi") ?? b"";
        let m = crypto.rsa_decrypt_oaep_sha1(k, crypto.rsa_encrypt_oaep_sha1(p, b"hi") ?? b"") ?? b"";
        return len(c) + len(m);
    }
    return dive(n - 1, k, p) + 0;
}

fn job(d: int, k: str, p: str) -> int {
    return dive(d, k, p);
}

