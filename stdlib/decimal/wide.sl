// The product of the low 5 limbs of a and of b (two coefficients, or a
// coefficient and an int): schoolbook by columns. A column is at most
// 5 products under 10^18, so it stays under 2^63 before the carry.
fn w_mul_coef(a: &Wide, b: &Wide) -> Wide {
