    let t = 0;
    t = c + a.w0 * b.w0;
    r.w0 = t % 1000000000;
    c = t / 1000000000;
    t = c + a.w0 * b.w1 + a.w1 * b.w0;
    r.w1 = t % 1000000000;
    c = t / 1000000000;
    t = c + a.w0 * b.w2 + a.w1 * b.w1 + a.w2 * b.w0;
    r.w2 = t % 1000000000;
    c = t / 1000000000;
    t = c + a.w0 * b.w3 + a.w1 * b.w2 + a.w2 * b.w1 + a.w3 * b.w0;
    r.w3 = t % 1000000000;
    c = t / 1000000000;
    t = c + a.w0 * b.w4 + a.w1 * b.w3 + a.w2 * b.w2 + a.w3 * b.w1 + a.w4 * b.w0;
    r.w4 = t % 1000000000;
    c = t / 1000000000;
    t = c + a.w1 * b.w4 + a.w2 * b.w3 + a.w3 * b.w2 + a.w4 * b.w1;
    r.w5 = t % 1000000000;
    c = t / 1000000000;
    t = c + a.w2 * b.w4 + a.w3 * b.w3 + a.w4 * b.w2;
    r.w6 = t % 1000000000;
    c = t / 1000000000;
    t = c + a.w3 * b.w4 + a.w4 * b.w3;
    r.w7 = t % 1000000000;
    c = t / 1000000000;
    t = c + a.w4 * b.w4;
    r.w8 = t % 1000000000;
    c = t / 1000000000;
    r.w9 = c % 1000000000;
    r.w10 = c / 1000000000;
    return r;
}
