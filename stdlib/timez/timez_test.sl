fn vectors() -> [[int]] {
    let out: [[int]] = [];
    for line in strings.split(vector_text(), "\n") {
        if len(line) == 0 {
            continue;
        }
        let row: [int] = [];
        for f in strings.split(line, " ") {
            push(row, to_int(f) ?? 0);
        }
        push(out, row);
    }
    return out;
}
