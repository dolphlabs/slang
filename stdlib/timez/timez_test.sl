// Unit tests: `slangc test stdlib/timez`.

import "strings";

fn t_utc(y: int, mo: int, d: int, h: int, mi: int, s: int, ns: int) -> Time {
    let r = utc(y, mo, d, h, mi, s, ns);
    guard let t = r else let e = err_of(r) { panic(e); }
    return t;
}

fn d_of(y: int, m: int, d: int) -> Date {
    let r = date(y, m, d);
    guard let x = r else let e = err_of(r) { panic(e); }
    return x;
}

fn test_calendar_fields_match_pythons_datetime() {
    for v in vectors() {
        let t = unix(v[0]);
        let what = "unix " + to_str(v[0]);
        assert(t.year() == v[1] && t.month() == v[2] && t.day() == v[3], what + " date");
        assert(t.hour() == v[4] && t.minute() == v[5] && t.second() == v[6], what + " time");
        assert(weekday_index(t.weekday()) == v[7], what + " weekday");
        assert(t.year_day() == v[8], what + " year day");
        let w = t.iso_week();
        assert(w.year == v[9] && w.week == v[10], what + " iso week " + to_str(w.year) + "-W" + to_str(w.week));
        // and back
        let back = t_utc(v[1], v[2], v[3], v[4], v[5], v[6], 0);
        assert(back.unix() == v[0], what + " round trip");
    }
}

fn test_utc_refuses_out_of_range_fields_and_names_them() {
    let cases = [[2026, 2, 29, 0, 0, 0], [2026, 13, 1, 0, 0, 0], [2026, 1, 1, 24, 0, 0],
                 [2026, 1, 1, 0, 60, 0], [2026, 1, 1, 0, 0, 60], [2026, 4, 31, 0, 0, 0]];
    let words = ["February 2026 (1-28)", "month 13", "hour 24", "minute 60", "second 60", "April 2026 (1-30)"];
    let i = 0;
    while i < len(cases) {
        let c = cases[i];
        let r = utc(c[0], c[1], c[2], c[3], c[4], c[5], 0);
        guard let _t = r else let e = err_of(r) {
            assert(strings.contains(e, words[i]), e);
            i = i + 1;
            continue;
        }
        panic("accepted " + words[i]);
    }
    guard let _ok = utc(2024, 2, 29, 23, 59, 59, 999999999) else { panic("leap day refused"); }
}

fn test_unix_milli_and_nano_floor_before_the_epoch() {
    let t = unix_milli(-1);
    assert(t.sec == -1 && t.nsec == 999000000, "-1ms is 1969-12-31T23:59:59.999");
    assert(t.year() == 1969 && t.second() == 59 && t.millisecond() == 999);
    let n = unix_nano(-1);
    assert(n.sec == -1 && n.nsec == 999999999);
    assert(unix_nano(1500000000).unix_milli() == 1500);
    assert(t_utc(1, 1, 1, 0, 0, 0, 0).unix_nano() == -9223372036854775807, "saturates, not wraps");
}

fn test_add_and_sub_carry_across_seconds_and_the_epoch() {
    let t = unix(0).add(-1);
    assert(t.sec == -1 && t.nsec == 999999999);
    let u = t.add(2);
    assert(u.sec == 0 && u.nsec == 1);
    assert(u.sub(t) == 2 && t.sub(u) == -2);
    let far = t_utc(1, 1, 1, 0, 0, 0, 0);
    let late = t_utc(9999, 1, 1, 0, 0, 0, 0);
    assert(late.sub(far) == 9223372036854775807, "past 292 years it saturates");
    assert(unix(100).add(90 * MINUTE).unix() == 100 + 5400);
}

fn test_months_clamp_to_the_end_of_the_month() {
    assert(d_of(2026, 1, 31).add_months(1).iso() == "2026-02-28");
    assert(d_of(2024, 1, 31).add_months(1).iso() == "2024-02-29");
    assert(d_of(2026, 3, 31).add_months(-1).iso() == "2026-02-28");
    assert(d_of(2026, 11, 30).add_months(3).iso() == "2027-02-28");
    assert(d_of(2026, 1, 15).add_months(-13).iso() == "2024-12-15");
    assert(d_of(2024, 2, 29).add_years(1).iso() == "2025-02-28");
    assert(d_of(2024, 2, 29).add_years(4).iso() == "2028-02-29");
    let t = t_utc(2026, 1, 31, 9, 30, 0, 5);
    let m = t.add_months(1);
    assert(m.date().iso() == "2026-02-28" && m.hour() == 9 && m.minute() == 30 && m.nanosecond() == 5);
}

fn test_dates() {
    let d = d_of(2026, 10, 13);
    assert(weekday_name(d.weekday()) == "Tuesday");
    assert(d.add_days(-13).iso() == "2026-09-30");
    assert(d.days_until(d_of(2027, 1, 1)) == 80);
    assert(d_of(1990, 10, 14).years_until(d) == 35, "the birthday has not come yet");
    assert(d_of(1990, 10, 13).years_until(d) == 36);
    assert(d.start().unix() == t_utc(2026, 10, 13, 0, 0, 0, 0).unix());
    assert(d.end_of_month().iso() == "2026-10-31" && d.start_of_month().iso() == "2026-10-01");
    assert(d.before(d.add_days(1)) && d.compare(d) == 0 && d.equal(d_of(2026, 10, 13)));
    assert(d_of(-44, 3, 15).iso() == "-0044-03-15" && d_of(12345, 1, 1).iso() == "+12345-01-01");
    assert(is_leap_year(2000) && !is_leap_year(1900) && is_leap_year(2024) && !is_leap_year(2026));
    assert(days_in_month(2026, 2) == 28 && days_in_month(2024, 2) == 29 && days_in_month(2026, 9) == 30);
    assert(month_name(10) == "October" && month_name(0) == "");
}

fn test_start_and_end_of_periods() {
    let t = t_utc(2026, 10, 15, 13, 45, 30, 123);
    assert(t.start_of_day().unix() == t_utc(2026, 10, 15, 0, 0, 0, 0).unix());
    assert(t.start_of_hour().minute() == 0 && t.start_of_hour().hour() == 13);
    assert(t.start_of_minute().second() == 0 && t.start_of_minute().nanosecond() == 0);
    assert(t.start_of_week().date().iso() == "2026-10-12", "the Monday of that week");
    assert(t.start_of_month().date().iso() == "2026-10-01");
    assert(t.start_of_year().date().iso() == "2026-01-01");
    let e = t.end_of_day();
    assert(e.hour() == 23 && e.minute() == 59 && e.second() == 59 && e.nanosecond() == 999999999);
    assert(t.end_of_month().date().iso() == "2026-10-31");
    assert(t.end_of_year().date().iso() == "2026-12-31");
    // before 1970, the week still starts on a Monday
    assert(t_utc(1969, 12, 31, 12, 0, 0, 0).start_of_week().date().iso() == "1969-12-29");
}

fn test_truncate_and_round() {
    let t = t_utc(2026, 10, 13, 9, 37, 45, 600000000);
    assert(t.truncate(MINUTE).second() == 0 && t.truncate(MINUTE).minute() == 37);
    assert(t.round(MINUTE).minute() == 38);
    assert(t.truncate(15 * MINUTE).minute() == 30);
    assert(t.truncate(SECOND).nanosecond() == 0);
    assert(t.round(SECOND).second() == 46);
    assert(t.truncate(250 * MILLISECOND).nanosecond() == 500000000);
    assert(t.truncate(0).equal(t));
    assert(unix(-1).truncate(MINUTE).unix() == -60, "floors before the epoch");
}

fn test_compare_min_max() {
    let a = unix(10);
    let b = unix_nano(10000000001);
    assert(a.before(b) && b.after(a) && !a.equal(b) && a.compare(b) == -1 && b.compare(a) == 1);
    assert(min(a, b).equal(a) && max(a, b).equal(b));
}

fn test_parse_duration_reads_go_and_days() {
    let cases = ["0", "1ns", "1.5s", "300ms", "2us", "2µs", "1h30m", "-2m", "+5s", "1h0m0.000000001s", "7d", "1.5h", ".5s", "1d12h"];
    let want = [0, 1, 1500000000, 300000000, 2000, 2000, 5400000000000, -120000000000, 5000000000,
                3600000000001, 604800000000000, 5400000000000, 500000000, 129600000000000];
    let i = 0;
    while i < len(cases) {
        let r = parse_duration(cases[i]);
        guard let v = r else let e = err_of(r) { panic(cases[i] + ": " + e); }
        assert(v == want[i], cases[i] + " = " + to_str(v));
        i = i + 1;
    }
    for bad in ["", "5", "1x", "h", ".h", "-", "1h-2m", "999999999999h"] {
        let r = parse_duration(bad);
        guard let _v = r else { continue; }
        panic("parse_duration accepted '" + bad + "'");
    }
}

fn test_format_duration_matches_go() {
    assert(format_duration(0) == "0s");
    assert(format_duration(999) == "999ns");
    assert(format_duration(1500) == "1.5µs");
    assert(format_duration(1500000) == "1.5ms");
    assert(format_duration(1500000000) == "1.5s");
    assert(format_duration(90 * MINUTE) == "1h30m0s");
    assert(format_duration(-2 * MINUTE) == "-2m0s");
    assert(format_duration(3600000000001) == "1h0m0.000000001s");
    assert(format_duration(25 * HOUR) == "25h0m0s");
    for d in [1, 999, 1500, 61000000000, 5400000000000, -3600000000001] {
        assert((parse_duration(format_duration(d)) ?? -7) == d, "round trip " + to_str(d));
    }
}
// Generated from Python's datetime (seed 20261013), one instant per line:
// unix seconds, year, month, day, hour, minute, second, weekday (Monday 0),
// day of year, ISO year, ISO week. Edge cases first: the epoch, either
