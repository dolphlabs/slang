import "strings";

fn z_load(name: str) -> Zone {
    let r = load_zone(name);
    guard let z = r else let e = err_of(r) { panic(e); }
    return z;
}

fn test_zones_match_pythons_zoneinfo() {
    let cache: map[str]Zone = {};
    let n = 0;
    for line in strings.split(zone_vector_text(), "\n") {
        if len(line) == 0 {
            continue;
        }
        let f = strings.split(line, " ");
        if !has(cache, f[0]) {
            cache[f[0]] = z_load(f[0]);
        }
        let z = cache[f[0]];
        let t = unix(to_int(f[1]) ?? 0);
        let zt = t.in_zone(z);
        let what = line;
        assert(zt.offset == (to_int(f[2]) ?? -1), what + " offset " + to_str(zt.offset));
        assert(zt.abbrev() == f[3], what + " abbrev " + zt.abbrev());
        assert(zt.format("%Y-%m-%dT%H:%M:%S") == f[4], what + " wall " + zt.format("%Y-%m-%dT%H:%M:%S"));
        n = n + 1;
    }
    assert(n == 420, to_str(n));
}

fn test_gap_and_overlap_follow_the_chosen_rule() {
    let b = z_load("Europe/Berlin");
    // 2026-03-29 02:30 does not exist in Berlin (02:00 -> 03:00)
    assert((zoned(b, 2026, 3, 29, 2, 30, 0, Disambiguation.COMPATIBLE) ?? unix(0)).unix() == 1774747800,
           "compatible: forward by the gap, 03:30 CEST");
    assert((zoned(b, 2026, 3, 29, 2, 30, 0, Disambiguation.LATER) ?? unix(0)).unix() == 1774747800);
    assert((zoned(b, 2026, 3, 29, 2, 30, 0, Disambiguation.EARLIER) ?? unix(0)).unix() == 1774744200,
           "earlier: back by the gap, 01:30 CET");
    let gap = zoned(b, 2026, 3, 29, 2, 30, 0, Disambiguation.REJECT);
    guard let _g = gap else let e = err_of(gap) {
        assert(strings.contains(e, "does not exist"), e);
        // 2026-10-25 02:30 happens twice in Berlin
        assert((zoned(b, 2026, 10, 25, 2, 30, 0, Disambiguation.COMPATIBLE) ?? unix(0)).unix() == 1792888200,
               "compatible: the earlier of the two");
        assert((zoned(b, 2026, 10, 25, 2, 30, 0, Disambiguation.LATER) ?? unix(0)).unix() == 1792891800);
        let twice = zoned(b, 2026, 10, 25, 2, 30, 0, Disambiguation.REJECT);
        guard let _t = twice else let e2 = err_of(twice) {
            assert(strings.contains(e2, "happens twice"), e2);
            // an ordinary time is unambiguous
            assert((zoned(b, 2026, 7, 1, 12, 0, 0, Disambiguation.REJECT) ?? unix(0)).unix() == 1782900000);
            return;
        }
        panic("an ambiguous time was accepted under REJECT");
    }
    panic("a skipped time was accepted under REJECT");
}

fn test_zoned_time_reads_and_formats_like_a_local_clock() {
    let ny = z_load("America/New_York");
    let t = unix(1791883815);   // 2026-10-13T09:30:15Z
    let zt = t.in_zone(ny);
    assert(zt.rfc3339() == "2026-10-13T05:30:15-04:00", zt.rfc3339());
    assert(zt.format("%H:%M %Z %z 100%%") == "05:30 EDT -0400 100%", zt.format("%H:%M %Z %z 100%%"));
    assert(zt.is_dst() && zt.hour() == 5 && zt.date().iso() == "2026-10-13");
    assert(weekday_name(zt.weekday()) == "Tuesday");
    let winter = unix(1798000000).in_zone(ny);
    assert(winter.abbrev() == "EST" && winter.offset == -18000);
}

fn test_calendar_arithmetic_keeps_the_wall_time_across_dst() {
    let b = z_load("Europe/Berlin");
    // Saturday 2026-03-28 09:00 CET, +1 day is Sunday 09:00 CEST: 23 hours
    let sat = (zoned(b, 2026, 3, 28, 9, 0, 0, Disambiguation.REJECT) ?? unix(0)).in_zone(b);
    let sun = sat.add_days(1);
    assert(sun.hour() == 9 && sun.day() == 29, sun.rfc3339());
    assert(sun.time.sub(sat.time) == 23 * HOUR, "a 23-hour day");
    assert(sat.add_months(1).rfc3339() == "2026-04-28T09:00:00+02:00");
    let noon = (zoned(b, 2026, 10, 25, 12, 0, 0, Disambiguation.REJECT) ?? unix(0)).in_zone(b);
    assert(noon.start_of_day().rfc3339() == "2026-10-25T00:00:00+02:00", noon.start_of_day().rfc3339());
}

fn test_fixed_zones_and_utc() {
    let ist = fixed_zone("IST", 19800);
    let zt = unix(1791883815).in_zone(ist);
    assert(zt.rfc3339() == "2026-10-13T15:00:15+05:30" && zt.abbrev() == "IST");
    let u = z_load("UTC");
    assert(unix(0).in_zone(u).rfc3339() == "1970-01-01T00:00:00Z");
}

fn test_zone_names_cannot_reach_other_files() {
    for bad in ["../../etc/passwd", "/etc/passwd", "Europe/../../etc", "Europe//Berlin", "", "Europe/Ber lin"] {
        let r = load_zone(bad);
        guard let _z = r else let e = err_of(r) {
            assert(strings.contains(e, "not a time zone name"), bad + ": " + e);
            continue;
        }
        panic("loaded '" + bad + "'");
    }
    let missing = load_zone("Mars/Olympus_Mons");
    guard let _m = missing else let e = err_of(missing) {
        assert(strings.contains(e, "unknown time zone") && strings.contains(e, "tzdata"), e);
        return;
    }
    panic("loaded a zone that does not exist");
}

fn test_posix_tz_rules() {
    let r = parse_posix_tz("CET-1CEST,M3.5.0,M10.5.0/3");
    guard let rule = r else let e = err_of(r) { panic(e); }
    assert(rule.std_off == 3600 && rule.dst_off == 7200 && rule.std_name == "CET" && rule.dst_name == "CEST");
    let r2 = parse_posix_tz("<+0530>-5:30");
    guard let ist = r2 else let e = err_of(r2) { panic(e); }
    assert(ist.std_off == 19800 && !ist.has_dst && ist.std_name == "+0530");
    let r3 = parse_posix_tz("AEST-10AEDT,M10.1.0,M4.1.0/3");
    guard let syd = r3 else let e = err_of(r3) { panic(e); }
    // January is summer in Sydney: DST spans the new year
    assert(rule_at(syd, 1767225600)[0] == 39600 && rule_at(syd, 1782900000)[0] == 36000);
    for bad in ["", "C-1", "CET-1CEST", "CET-1CEST,M13.5.0,M10.5.0"] {
        let b = parse_posix_tz(bad);
        guard let _x = b else { continue; }
        panic("accepted '" + bad + "'");
    }
}
